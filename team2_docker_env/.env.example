# ---------------------------------------------------------------- PostgreSQL (app database)
# Keep the password alphanumeric: it is embedded in connection URLs (MLflow backend, Airflow).
POSTGRES_USER=dsp_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dsp_app
DATABASE_URL=postgresql://dsp_user:change_me@db:5432/dsp_app

# ---------------------------------------------------------------- Airflow
# Airflow metadata database (same Postgres instance, separate database)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://dsp_user:change_me@db:5432/airflow
# Generate your own with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=change_me_generate_with_fernet
# Shared secret used to sign/verify internal API auth tokens between the Airflow
# containers (scheduler, dag-processor, api-server) -- must be identical across all
# of them. Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=change_me_generate_with_secrets_token_hex
# Airflow login is NOT set here -- Simple Auth Manager auto-generates the admin
# password on first boot and logs it once. See README "Accessing the services".
# Used internally by Airflow (Flask sessions, log-fetching auth between
# scheduler/apiserver/dag-processor) -- must be identical across all
# Airflow containers, same as JWT_SECRET above. Generate your own with:
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_generate_with_secrets_token_hex

# ---------------------------------------------------------------- model_service / webapp
API_BASE_URL=http://model_service:8000
MODEL_NAME=stroke_model

# ---------------------------------------------------------------- Microsoft Teams (two channels)
# Incoming-webhook / Workflows URL of the "Data Quality Alerts" channel
#   -> Airflow ingestion alerts + Grafana data-quality alerts
TEAMS_DQ_WEBHOOK_URL=
# Incoming-webhook / Workflows URL of the "ML Alerts" channel
#   -> training-DAG promotion failures + Grafana drift / prediction alerts
TEAMS_ML_WEBHOOK_URL=

# ---------------------------------------------------------------- Defense 2 services (host ports)
MLFLOW_PORT=5000
NGINX_PORT=8081
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------- Training DAG (all optional)
# Cron schedule of the training DAG
TRAINING_SCHEDULE=*/10 * * * *
# New good_data files needed since the last training run before retraining starts
TRAINING_MIN_NEW_FILES=5
# Promotion metric: f1 | accuracy | roc_auc | precision | recall
TRAINING_PRIMARY_METRIC=f1
# Max mean latency (ms) of one single-row prediction for a candidate to be promoted
TRAINING_INFERENCE_THRESHOLD_MS=200
# These can also be changed per run in the Airflow "Trigger DAG" form.
