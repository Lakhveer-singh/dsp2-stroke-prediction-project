      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH b AS (\n  SELECT feature_name, min_value, max_value FROM training_stats WHERE is_baseline AND feature_type = 'numerical'\n)\nSELECT date_bin('5 minutes', p.prediction_time, TIMESTAMPTZ '2000-01-01') AS \"time\",\n       100.0 * AVG(((p.age < (SELECT min_value FROM b WHERE feature_name = 'age'))\n                  OR (p.age > (SELECT max_value FROM b WHERE feature_name = 'age')))::int) AS \"age\" ,\n       100.0 * AVG(((p.avg_glucose_level < (SELECT min_value FROM b WHERE feature_name = 'avg_glucose_level'))\n                  OR (p.avg_glucose_level > (SELECT max_value FROM b WHERE feature_name = 'avg_glucose_level')))::int) AS \"avg_glucose_level\" ,\n       100.0 * AVG(((p.bmi < (SELECT min_value FROM b WHERE feature_name = 'bmi'))\n                  OR (p.bmi > (SELECT max_value FROM b WHERE feature_name = 'bmi')))::int) AS \"bmi\" \nFROM predictions p\nWHERE $__timeFilter(p.prediction_time)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
