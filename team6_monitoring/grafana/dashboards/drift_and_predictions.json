                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "serving mean (5 min)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_bin('5 minutes', p.prediction_time, TIMESTAMPTZ '2000-01-01') AS \"time\",\n       AVG(p.${num_feature}) AS \"serving mean (5 min)\",\n       (SELECT mean FROM training_stats WHERE is_baseline AND feature_name = '${num_feature}') AS \"training baseline\"\nFROM predictions p\nWHERE $__timeFilter(p.prediction_time)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Numerical drift score (z-score of the 5 min mean vs training baseline)",
      "description": "|serving mean - training mean| / (training std / sqrt(n)). Green < 2, orange 2-3, red >= 3: a value >= 3 means the mean moved far more than sampling noise explains.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "spanNulls": true,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH b AS (\n  SELECT feature_name, mean, std FROM training_stats WHERE is_baseline AND feature_type = 'numerical'\n), s AS (\n  SELECT date_bin('5 minutes', prediction_time, TIMESTAMPTZ '2000-01-01') AS time, COUNT(*)::float AS n,\n         AVG(age) AS age, AVG(avg_glucose_level) AS avg_glucose_level, AVG(bmi) AS bmi\n  FROM predictions\n  WHERE $__timeFilter(prediction_time)\n  GROUP BY 1\n)\nSELECT s.time AS \"time\",\n       ABS(s.age - (SELECT mean FROM b WHERE feature_name = 'age'))\n         / NULLIF((SELECT std FROM b WHERE feature_name = 'age') / SQRT(s.n), 0) AS \"age\" ,\n       ABS(s.avg_glucose_level - (SELECT mean FROM b WHERE feature_name = 'avg_glucose_level'))\n         / NULLIF((SELECT std FROM b WHERE feature_name = 'avg_glucose_level') / SQRT(s.n), 0) AS \"avg_glucose_level\" ,\n       ABS(s.bmi - (SELECT mean FROM b WHERE feature_name = 'bmi'))\n         / NULLIF((SELECT std FROM b WHERE feature_name = 'bmi') / SQRT(s.n), 0) AS \"bmi\" \nFROM s\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Categorical drift: distance to the training category shares (smoking_status, work_type, gender)",
      "description": "Total variation distance = 0.5 * sum |serving share - training share| per 5 min bucket (0 = identical, 1 = completely different). Green < 0.2, orange 0.2-0.35, red >= 0.35.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "showPoints": "auto",
            "spanNulls": true,
            "barAlignment": 0,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.35
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH unpiv AS (\n  SELECT date_bin('5 minutes', prediction_time, TIMESTAMPTZ '2000-01-01') AS time, 'smoking_status' AS feature, smoking_status::text AS category\n  FROM predictions WHERE $__timeFilter(prediction_time)\n  UNION ALL\n  SELECT date_bin('5 minutes', prediction_time, TIMESTAMPTZ '2000-01-01') AS time, 'work_type' AS feature, work_type::text AS category\n  FROM predictions WHERE $__timeFilter(prediction_time)\n  UNION ALL\n  SELECT date_bin('5 minutes', prediction_time, TIMESTAMPTZ '2000-01-01') AS time, 'gender' AS feature, gender::text AS category\n  FROM predictions WHERE $__timeFilter(prediction_time)\n), serv AS (\n  SELECT time, feature, category, COUNT(*)::float AS n FROM unpiv GROUP BY 1, 2, 3\n), tot AS (\n  SELECT time, feature, SUM(n) AS total FROM serv GROUP BY 1, 2\n), base AS (\n  SELECT feature_name AS feature, category, proportion FROM training_stats\n  WHERE is_baseline AND feature_type = 'categorical' AND feature_name IN ('smoking_status', 'work_type', 'gender')\n), cats AS (\n  SELECT feature, category FROM base UNION SELECT feature, category FROM serv\n), grid AS (\n  SELECT t.time, t.feature, t.total, c.category FROM tot t JOIN cats c ON c.feature = t.feature\n)\nSELECT g.time AS \"time\", g.feature AS metric,\n       0.5 * SUM(ABS(COALESCE(s.n, 0) / g.total - COALESCE(b.proportion, 0))) AS \"value\"\nFROM grid g\nLEFT JOIN serv s ON s.time = g.time AND s.feature = g.feature AND s.category = g.category\nLEFT JOIN base b ON b.feature = g.feature AND b.category = g.category\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Share of serving values outside the training range (age, glucose, bmi)",
      "description": "Percentage of predictions whose feature value is below the training minimum or above the training maximum. Green < 5 %, orange 5-20 %, red >= 20 %.",
