{
  "uid": "dsp-drift-predictions",
  "title": "DSP | Data drift & prediction monitoring",
  "description": "ML engineers: serving data vs the champion model's training baseline, and model behaviour over time (last hour, auto-refresh).",
  "tags": [
    "dsp",
    "ml",
    "drift"
  ],
