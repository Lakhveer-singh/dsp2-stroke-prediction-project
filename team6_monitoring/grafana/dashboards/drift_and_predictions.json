  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Numerical feature drift: serving mean vs training baseline (pick the feature above)",
      "description": "Mean of the selected numerical feature in the predictions table (5 min buckets) against the mean of the CHAMPION model's training data (dashed).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
